{
  "name": "@webview-native-ui/engine",
  "version": "1.0.6",
  "description": "Native UI placement, scroll tracking, and Web projection for Capacitor and Cordova plugin maintainers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webview-native-ui/engine.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ionic": {
      "types": "./dist/ionic.d.ts",
      "import": "./dist/ionic.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./controls/ionic": {
      "types": "./dist/controls/ionic.d.ts",
      "import": "./dist/controls/ionic.js"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    }
  },
  "files": [
    "dist",
    "ios/Sources",
    "WebViewNativeUIEngine.podspec",
    "README.md",
    "LICENSE",
    "docs",
    "src",
    "WebViewNativeUIControls.podspec",
    "native/artifacts/NativeUIPng.xcframework",
    "native/licenses"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "lint": "npm run typecheck && eslint . --max-warnings 0 && npm run format:check",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml,html}\"",
    "prepublishOnly": "npm run build",
    "test:release": "node --test scripts/native-ui-engine-release/*.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "test:cordova": "node scripts/verify-cordova.mjs",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml,html}\"",
    "swiftlint": "node-swiftlint",
    "lint:swift": "swiftlint version && node-swiftlint lint --strict --no-cache",
    "format:swift": "swiftlint version && node-swiftlint --fix --format --no-cache",
    "lint:android": "android/gradlew -p android ktfmtCheck lintRelease",
    "format:kotlin": "android/gradlew -p android ktfmtFormat",
    "test:controls": "vitest run",
    "test:rust": "cargo test --locked --manifest-path native/png/Cargo.toml",
    "build:native": "python3 scripts/build-native-png.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ionic/swiftlint-config": "^2.0.0",
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "@ionic/core": "^8.8.1",
    "vitest": "^4.0.0",
    "jsdom": "^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9",
    "@ionic/core": ">=8.8.1 <10"
  },
  "types": "./dist/index.d.ts",
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "@ionic/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@rdlabo/ionic-theme-utils": "0.1.5"
  }
}

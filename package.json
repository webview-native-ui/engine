{
  "name": "@rdlabo/capacitor-native-ui-engine",
  "version": "2.0.3",
  "description": "Native UI placement, scroll tracking, and Web projection for Capacitor and Cordova plugin maintainers.",
  "type": "module",
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdlabo-dev/capacitor-native-ui-engine.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ionic": {
      "types": "./dist/ionic.d.ts",
      "import": "./dist/ionic.js"
    }
  },
  "files": [
    "dist",
    "ios/Sources",
    "CapacitorNativeUIEngine.podspec",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "lint": "npm run typecheck && prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml,html}\"",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml,html}\"",
    "prepublishOnly": "npm run build",
    "test:release": "node --test scripts/native-ui-engine-release/publish.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "release": "np --no-publish --no-tests --branch main",
    "test:cordova": "node scripts/verify-cordova.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "prettier": "^3.6.2",
    "np": "^10.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9"
  },
  "types": "./dist/index.d.ts",
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    }
  }
}
